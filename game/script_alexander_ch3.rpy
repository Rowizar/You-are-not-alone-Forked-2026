# Начало третьей главы рута Александра

# Переменные ветки
default slapped_shnurok = False     # Дал ли ГГ Шнурку пощёчину
default cipher_remembered = False   # Запомнил ли ГГ шифр из сна
default cipher_solved = False       # Ввёл ли ГГ шифр правильно

# Подгонка крупных CG под 1920x1080
image cj_аудитория_задник = Transform("cj/cj_аудитория_задник.png", xysize=(1920, 1080))
image cj_аудитория_направо = Transform("cj/cj_аудитория_направо.png", xysize=(1920, 1080))

label alexander_ch3:
$ save_name = _("Глава 3. Саша")

play sound tire
scene cj_cake with dissolve

show alex смущенный покрасневший at right2 with dissolve

sh "ну и чё ты тут забыл?"

scene black with dissolve
pause 2

return



# === Скрытая ветка Евы: сон в аудитории ===
label hidden_eva_branch:
    default eva_looked_left = False
    default eva_looked_right = False
    $ save_name = _("Глава ??")    
    "Вы вышли на скрытую концовку."

    stop music fadeout 1.5
    scene cj_аудитория_в_паутине with dissolve
    play music mystery fadein 2.0

    "Вдруг, открыв глаза, я заметил, что обстановка как-то изменилась. Я всё ещё находился в аудитории, но не в той, в которой был перед тем, как заснул."

    "Стены были покрыты паутиной, а на партах лежал толстый слой пыли. И ещё мне было холодно, очень холодно."

    "Этот сон казался слишком правдоподобным и осознанным. Всё вокруг выглядело так, будто это место давно заброшено."

    "Это всё очень странно… Нужно понять, что происходит."

    jump eva_dream_choice


label eva_dream_choice:
    menu:
        "Посмотреть налево" if not eva_looked_left:
            $ eva_looked_left = True
            jump eva_look_left

        "Посмотреть направо" if not eva_looked_right:
            $ eva_looked_right = True
            jump eva_look_right

        "Обернуться" if eva_looked_left and eva_looked_right:
            jump eva_turn_around


label eva_look_left:
    scene cj_аудитория_налево with dissolve

    "Я повернул голову налево. Все окна в аудитории были разбиты. Не просто треснувшие стекла, а полностью выбитые рамы, через которые свободно проникал холодный воздух."

    "Длинные занавески, когда-то белые, а теперь серые от пыли, безвольно болтались, шевелясь от сквозняка."

    "Осколки стекла покрывали подоконники и пол, смешиваясь с опавшими листьями, принесёнными ветром, и какими-то бумажными обрывками."

    "В углу у окна лежал разбитый цветочный горшок, а земля из него давно превратилась в горстку пыли. Создавалось впечатление, что здесь не просто не убирались, а бросили всё в спешке."

    "Что же тут могло случиться?"

    jump eva_dream_choice


label eva_look_right:
    scene cj_аудитория_направо with dissolve

    "Я посмотрел направо, и мне стало не по себе. Там, где раньше висела доска, теперь вырисовывалось лишь пятно на голой стене и несколько торчащих гвоздей."

    "Парты были перевёрнуты, а одна вообще оказалась разломанной пополам. Мне всё это не понравилось. Я изо всех сил пытался заставить себя проснуться."

    "Даже в обычные дни эта аудитория не вызывала у меня восторга, но сейчас от неё веяло чем-то откровенно плохим."

    "Обычно в таких заброшенных местах можно ожидать чего угодно, от привидения декана, читающего нотацию пустоте, до призрака студента, вечно пересдающего матанализ. Вот бы поскорее выбраться отсюда."

    jump eva_dream_choice


label eva_turn_around:
    scene cj_аудитория_задник with dissolve

    "Я сидел и думал, что только в таких условиях я бы вряд ли спал на парах и, может быть, даже вникал бы в то, что говорит препод."

    "Хотя нет, лучше отчислиться, чем учиться в таких условиях."

    "Может, я просто вижу будущее? И через какой-то промежуток времени тут и правда будет так."

    "На удивление, я понял, что не испытываю жалости к этому месту. Мне безразлична его дальнейшая судьба. Главное — самому успеть выпуститься, пока тут ещё более-менее нормально."

    jump eva_scream


# === Скример с Евой и шифр ===
label eva_scream:
    stop music
    pause 0.5
    play sound screamer
    scene cj_скример_ева with vpunch
    pause 1.0

    dots "nsdbyjdfn!!!!##2029db151631n!dc\\101917jh20bk…"

    scene black with dissolve

    "Что это было?..."

    menu:
        "Быстрее проснуться":
            $ cipher_remembered = False
            jump eva_wake_up

        "Запомнить":
            $ cipher_remembered = True
            jump eva_wake_up


# === Пробуждение и запись в дневнике ===
label eva_wake_up:
    scene bg_classroom with dissolve
    play music darkrooms fadein 1.0

    "Я дёрнулся и поднял голову. Громкий стук разнёсся по аудитории — это мой локоть ударился об парту. Сон как рукой сняло."

    "На меня злобно глядел Шнурок, а пара соседей ехидно ухмыльнулись. Чёрт, опять опозорился."

    "Чтобы прийти в себя, я открыл дневник и начал строчить в него все свои негативные мысли: про Шнурка, про проблемы с учёбой, которые я сам себе заработал, и про этот дурацкий сон."

    "Я отчётливо запомнил, что кого-то видел и пытался понять, что же это было."

    "Чем больше я об этом думал, тем больше мне становилось не по себе. Чтобы хоть как-то отвлечься от этого груза, я попробовал вслушаться в речь препода, но в голове лишь стоял гул."

    "Спустя время, я снова открыл дневник, чтобы записать что-нибудь злое и безнадёжное. И замер."

    # TODO: подставить cj_тетрадь_ты_виноват когда пересохранят TIF в PNG
    scene cj_аудитория_задник with dissolve

    "Среди моих размашистых, нервных записей виднелась строка:"

    e "ты виноват"

    scene bg_classroom with dissolve

    "Разве я писал это? Не похоже… Может, это чей-то глупый прикол? Или у меня опять начинаются какие-то видения?"

    if cipher_remembered:
        "Интересно, что значит эта фраза из сна? Как там было?… Вроде начиналась как-то так: «nsdbyjdfn…»."

        "Я вывел этот непонятный шифр ручкой в дневник и вздохнул."

        "Надо бы попытаться потом понять, что это значит."

    "Чувствую себя слишком сонно, чтобы что-то анализировать. Совсем нет настроения сейчас, чтобы этим заниматься."

    jump cipher_input


# === Ввод шифра — ключ к секретной концовке ===
label cipher_input:
    "Перед самым окончанием пары я снова открыл дневник на той странной странице. Что-то в этой последовательности символов цепляло меня — как будто разгадка прямо передо мной, нужно только сложить."

    "Я взял ручку, опёрся локтем о парту и попробовал переписать шифр ещё раз, сосредоточившись."

    python:
        attempt = renpy.input(_("Введите шифр"), default="", length=64).strip().lower()
        correct = "nsdbyjdfn!!!!##2029db151631n!dc\\101917jh20bk"
        cipher_solved = (attempt == correct)

    if not cipher_solved:
        "Что-то не сходится. Буквы вроде те же, а ощущение, что я ошибся."

        "Попробую ещё раз. Последний шанс не свалить эту мысль в долгий ящик."

        python:
            attempt2 = renpy.input(_("Введите шифр ещё раз"), default="", length=64).strip().lower()
            cipher_solved = (attempt2 == correct)

    if cipher_solved:
        play sound screamer_short
        scene black with vpunch
        pause 0.5

        "В висках стрельнуло. На мгновение в голове щёлкнуло, как будто кто-то повернул выключатель."

        "Голос Евы, далёкий и шепчущий, прозвучал прямо у меня в голове:"

        e "Ты понял. Тогда ты должен пойти и увидеть."

        jump night_walk

    else:
        "Бесполезно. Память подводит, или это вообще была какая-то бессмыслица из сна."

        "Закрыл дневник и больше к нему не возвращался."

        jump alex_bad_end


# === Ночная улица, цветы, рука, Ева, машина ===
label night_walk:
    stop music fadeout 2.0
    # TODO: подставить bg_улица_темная когда нарисуют. Пока используем существующий ночной фон.
    scene bg_street_night_winter with dissolve
    play background wind fadein 2.0
    play music mystery fadein 2.0

    "После пар я отправился домой. В этот день особенно быстро стемнело, будто кто-то спешил укутать город в одеяло ночи."

    "Голова гудела от мыслей обо всём, что на меня навалилось: ссора со Шнурком и его презрительный взгляд на паре, проект, из которого меня выгнали и теперь придётся искать другой."

    "Этот сон, после которого до сих пор оставались очень неприятные чувства и тревожность."

    "Постепенно, сквозь этот внутренний шум из собственных мыслей, стало пробиваться чувство… неправильности. Я замедлил шаг и наконец поднял голову."

    "Я остановился и огляделся. Слишком тихо. Где все? Улица была пустой. Ни машин, ни людей. Вообще никого."

    "Сумрак был каким-то неестественным, глубоким, будто краски мира потускнели, оставив только грязно-серые и коричневые тона. Фонари горели тускло, и их свет не рассеивал тьму, а лишь подчёркивал её, отбрасывая длинные, искажённые тени."

    "Всё вокруг казалось застывшим, неживым."

    "И эта атмосфера… Похожая на… тот сон? По спине поползли мурашки."

    "Я ещё раз огляделся и вдруг понял, что я шёл вообще не в эту сторону. Я посмотрел на знакомый поворот, но сначала не узнал его. Где я видел эту локацию?"

    "И тут до меня дошло: газета. Я видел это место в газете, в тот день, когда убирался в кладовке. Здесь было ДТП."

    "Но как я здесь оказался? Я же не сворачивал сюда. Ноги сами принесли меня, будто кто-то другой управлял моим телом, пока я был погружён в свои мрачные мысли."

    scene cj_увядшие_цветы_снег with dissolve

    "Я посмотрел на асфальт рядом. У самого края дороги кто-то оставил цветы. Небольшой букетик гвоздик, который уже начал увядать. Всюду лежали алые лепестки, раскиданные ветром."

    "Они были на серой, мёртвой земле. Такие, ярко-красные, они казались каплями свежей крови на грязном снегу. Как будто это единственное живое пятно в этом застывшем мире."

    mc "Интересно, кто их тут оставил?.."

    "Вдруг меня охватило странное, непреодолимое желание — дотронуться до них. Просто прикоснуться кончиками пальцев к этим бархатным лепесткам."

    "Будто в них была какая-то подсказка, ответ, который я не мог найти в своей памяти. В лепестках ещё теплилась жизнь, они не до конца увяли, и эта оставшаяся энергия была как огонёк в кромешной тьме."

    "Нет, это же глупо. И вообще, вдруг меня кто-то заметит? Что тогда обо мне подумают? Это какое-то кощунство, совсем неправильно будет их трогать."

    "Но рациональные доводы разбивались о какую-то инстинктивную, животную тягу. Рука сама потянулась вперёд, не слушаясь меня. Я медленно наклонился, палец уже был готов коснуться прохладных лепестков…"

    play sound stuk

    # TODO: подставить cj_рука_из_кустов когда нарисуют. Пока эффект через звук + затемнение.
    scene cj_увядшие_цветы_снег with vpunch
    pause 0.5

    "ЧТО ЭТО??? Сердце выпрыгивало из груди, дыхание перехватило. Я отпрыгнул на шаг назад, чуть не поскользнувшись."

    "Такого не может быть! Это что, человеческая рука? Но она была… другой. Слишком длинной, слишком костлявой, цветом у старого мрамора. И движения её были резкими, рваными, неживыми. И уж точно, это было не животное."

    "Взгляд метнулся к кустам. Цветов на обочине больше не было. Но от того места, где они лежали, в тёмной чаще кустов, тянулась неровная дорожка из алых лепестков. Словно кто-то, истекая кровью, уполз в эту тьму."

    "Я оцепенел. Ноги будто ватные, но какая-то неведомая сила заставила меня сделать шаг вперёд. Я медленно, затаив дыхание, заглянул в густую, непроглядную темноту между ветвей."

    play sound screamer_short
    scene cj_два_красных_глаза_в_кустах with vpunch
    pause 1.0

    "Чьи это глаза?? Почему они смотрят на меня??"

    "В висках застучало, и в голове зазвучал чужой голос:"

    e "ТЫ ВИНОВАТ!!"

    "Кто это?? В чём я виноват? Что я сделал?!"

    scene black with dissolve

    "Тени вокруг вдруг сгустились, стали плотными, почти осязаемыми. Они зашевелились."

    "Из кустов, с противным, сухим шелестом, выползло это существо. Этот призрак, который преследовал меня."

    "Её движения были выверенными, тело изгибалось так, как не должен изгибаться человек."

    "А из сгущающегося мрака, со всех сторон, поползли, вытягиваясь, длинные бледные руки-тени. Они тянулись ко мне, к моим ногам, к рукам, пытаясь ухватиться, удержать меня."

    "Дикая и всепоглощающая паника сдавила горло. Я отступал в ужасе, не глядя, и чувствуя, как ледяные пальцы скользят по мне. Ещё шаг. И ещё."

    "Я почувствовал, как отступил на проезжую часть. Издалека надвигались какие-то звуки."

    play sound tire

    "Из-за поворота, словно из ниоткуда, мчалась машина. Свет фар ослепил, визг тормозов разрезал тишину. Я не успел даже понять, что происходит, и в ужасе открыл глаза."

    scene bg_classroom with dissolve
    stop background fadeout 2.0
    stop music fadeout 2.0

    "Я сидел в аудитории. В горле стоял ком, сердце бешено колотилось. Рукой провёл по лицу, по груди — целый."

    "Преподаватель монотонно бубнил у доски. Шнурок что-то строчил в тетради, не глядя на меня. Никто не оглянулся, никто не заметил моего испуганного вздоха."

    "Я смотрел на их спокойные, равнодушные лица, и меня охватило новое, леденящее чувство. Чувство полной, абсолютной невидимости."

    "Будто меня правда только что сбили, и теперь я стал призраком."

    jump alex_secret_end


# === Концовка «Ты ничего не понял» ===
label alex_secret_end:
    $ set_quick_menu(False)
    scene black with dissolve
    play background wind fadein 2.0
    pause 2.0

    centered "{size=+30}{color=#ff0000}Ты ничего не понял."

    pause 4.0

    $ persistent.ending_alex_secret = True
    stop background fadeout 2.0

    return


# === Обычная плохая концовка (если шифр не введён правильно) ===
label alex_bad_end:
    stop music fadeout 2.0
    scene black with dissolve
    play background wind fadein 1.0
    pause 1.5

    "Дни тянулись один за другим, как серая пелена. С Шнурком я больше не разговаривал. Из его проекта меня тихо исключили, а академический долг так и висел."

    "Что-то во мне сломалось в тот день в библиотеке. Не уверен, что когда-нибудь починится."

    centered "{size=+24}{color=#ffffff}Давай помогу начать всё сначала."

    pause 3.0

    $ persistent.ending_alex_bad = True
    stop background fadeout 1.0

    return
